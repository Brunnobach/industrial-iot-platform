# Local development defaults. Copy to .env to override:
#   cp .env.example .env
#
# Docker Compose interpolates these values. If .env is missing, the
# same defaults in docker-compose.yml are used, so `docker compose up -d`
# still starts the stack in one command.
#
# Do not use these values outside local development.

# InfluxDB (also consumed by the API, ingestion service, and Grafana)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=adminpassword
INFLUX_TOKEN=iiot-token
INFLUX_ORG=iiot-org
INFLUX_BUCKET=iiot-bucket

# Grafana UI
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS_ENABLED=true

# Simulator publish interval in seconds
SIM_INTERVAL=1.0

# Host-side only (when running Python on the host, not inside Compose).
# Compose services ignore these and use the internal Docker DNS names.
# INFLUX_URL=http://localhost:8086
# MQTT_HOST=localhost
# MQTT_PORT=1883
